---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

// 路径段 → 中文名。**命不中就原样输出路径段，而且不报错** ——
// 所以这张表漏一行的症状只是页面上多出一个英文单词，没有任何测试会红。
const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  qa: t.nav.qa,
  guides: t.nav.guides,
  prompts: t.nav.prompts,
  // ★【2026-09-18 修】这一行以前没有，于是 /s/ 的面包屑一直显示「首页 » s」
  //   （在 dist/s/index.html 里核实过），尽管 i18n 里 nav.symbols = "标的"
  //   从一开始就存在。漏的不是文案，是这张表里的一行。
  s: t.nav.symbols,
  tags: t.nav.tags,
  about: t.nav.about,
  archives: t.nav.archives,
  search: t.nav.search,
};

/**
 * 首段本身就是一个分页列表的集合：/posts/2 → 「研究 (第 2)」、/qa/2 → 「问答 (第 2)」。
 * 第 1 页**不带页码**：/posts → 「研究」。【2026-09-20 改】原来印「研究 (第 1)」，
 * 一个每个模块首页都有、永远是 1 的数字不带任何信息（标签那条一直是这么处理的，见下面）。
 *
 * ★ 做成一张表而不是每个集合一个 if：写死的分支正是下一个集合上线时会被漏掉的地方，
 *   而漏掉的症状是面包屑显示成「问答 » 2」—— 不报错、不会红。
 * ⚠ 不许把 `s` 加进来：/s/ 是一张不分页的总表，套上这条会显示成「标的 (第 1)」，
 *   一个不存在的页码比没有页码糟糕得多。
 * ⚠ `tags` 也不在这里：它的页码在第 3 段（/tags/<标签>/2），形状不同，见下面那条。
 */
const PAGINATED_ROOTS: readonly string[] = ["posts", "qa", "guides", "prompts"];

// if breadcrumb is Home > Posts > [page] <etc>
// replace Posts with localized "Posts (page number)"
const paginatedRoot = breadcrumbList[0];
const maybePageSegment = breadcrumbList[1];
// ⚠ 第二段必须是"没有"或"纯数字"才当页码用。少了这个判断，/qa/some-slug
//   这种详情页地址会被显示成「问答 (第 some-slug)」—— 今天详情页不渲染面包屑
//   所以看不见，但那是别人往详情页加一行 <Breadcrumb /> 就会踩到的坑。
//   这条判断不改变任何现存页面的输出：/posts 没有第二段，/posts/2 是数字。
if (
  paginatedRoot &&
  PAGINATED_ROOTS.includes(paginatedRoot) &&
  (!maybePageSegment || /^\d+$/.test(maybePageSegment))
) {
  const pageNo = Number(breadcrumbList[1] || 1);
  const rootLabel = navLabels[paginatedRoot] ?? paginatedRoot;
  breadcrumbList.splice(
    0,
    2,
    pageNo === 1
      ? rootLabel
      : `${rootLabel} (${t.pagination.page.toLowerCase()} ${pageNo})`
  );
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with localized [tag] (page number)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${decodeSegment(breadcrumbList[1])} ${
      Number(breadcrumbList[2]) === 1
        ? ""
        : `(${t.pagination.page.toLowerCase()} ${breadcrumbList[2]})`
    }`
  );
}
---

{
  /* ★ 分隔符从 `»` 换成 `/`，层级色从 `opacity-*` 换成 `--muted-foreground`
   *  （2026-09-18 改）。两件事各有理由：
   *
   *  ① `»` 是西文的引导符，夹在中文词之间（「首页 » 研究」）字重和字宽都不搭，
   *     而且和正文里真实的书名号 `《》` 形近。`/` 是路径分隔符的通用记号
   *     （GitHub、Stripe、Vercel 的面包屑都用它），读者一眼知道这是地址结构。
   *  ② `opacity` 是把**整个元素**连同它的焦点框一起调淡 —— 键盘用户 Tab 到
   *     面包屑上时，那圈焦点虚线也跟着变成 70% 透明。改成直接给颜色，
   *     焦点框保持满强度。 */
}
<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="text-muted-foreground flex flex-wrap items-center gap-x-1.5 text-sm"
  >
    <li class="flex items-center gap-x-1.5">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="hover:text-foreground transition-colors"
      >
        {t.nav.home}
      </a>
      <span aria-hidden="true">/</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class:list={[
                "text-foreground capitalize",
                { lowercase: index > 0 },
              ]}
              aria-current="page"
            >
              {/* make the last part lowercase in Home > Tags > some-tag */}
              {navLabels[breadcrumb] ?? decodeSegment(breadcrumb)}
            </span>
          </li>
        ) : (
          <li class="flex items-center gap-x-1.5">
            <a
              href={getRelativeLocaleUrl(locale, breadcrumb)}
              class="hover:text-foreground capitalize transition-colors"
            >
              {navLabels[breadcrumb] ?? decodeSegment(breadcrumb)}
            </a>
            <span aria-hidden="true">/</span>
          </li>
        )
      )
    }
  </ul>
</nav>
