---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { foldQaGroups } from "@/utils/qaGroups";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  // 标签是跨集合的：同一个「财报」既可能挂在研究稿上，也可能挂在一条问答上。
  // 路径与页内列表都从合并后的集合推 —— 只喂 posts 会让"只有问答用过"的标签
  // 变成一条 404（而 /tags 索引页照常把它列出来）。
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const qaEntries = await getCollection("qa", ({ data }) => !data.draft);
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  const prompts = await getCollection("prompts", ({ data }) => !data.draft);
  const entries = [...posts, ...qaEntries, ...guides, ...prompts];
  const tags = getUniqueTags(entries);

  return tags.flatMap(({ tag, tagName }) => {
    const tagEntries = getSortedPosts(
      entries.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );

    // 同一个问题的几条回答折成一张卡（src/utils/qaGroups.ts）；别的集合原样一条一卡。
    return paginate(foldQaGroups(tagEntries), {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
/** 页头那句和 <meta name="description"> 是同一句。【2026-09-20】标签页原来没传 description，
 *  每一页都落到站点默认那句 —— 几十个标签页在搜索引擎眼里描述完全相同。 */
const pageDesc = `${t.pages.tagDesc} "${tagName}".`;
---

<Layout
  title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}
  description={pageDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={`${t.pages.tagTitle}: ${tagName}`} pageDesc={pageDesc}>
    <ul>
      {page.data.map(({ entry, answers }) => <Card {...entry} {answers} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
