---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import EmptyState from "@/components/EmptyState.astro";
import CollectionSearch from "@/components/CollectionSearch.astro";
import { SEARCH_KINDS } from "@/config/searchKinds";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

/**
 * 提示词列表页。形状和 `guides/[...page].astro` **逐行同构**，只多一块投稿说明。
 *
 * ★ 文件名里的 `[...page]` 是硬性的：Astro 把分页参数名写死成字符串 "page"，
 *   路由里没有这一段时 `paginate()` 直接抛 PageNumberParamNotFound。
 *   改名成 `index.astro` 会让整个 /prompts 在构建期炸掉。
 */
export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getCollection("prompts", ({ data }) => !data.draft);

  // ★ 必须过 getSortedPosts()：它内部的 postFilter 是「草稿 / 定时未到的条目
  //   不生成页面」的**唯一**机制（docs/engineering-notes.md 坑 1）。
  return paginate(getSortedPosts(entries), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.promptsTitle} | ${config.site.title}`}
  description={t.pages.promptsDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.promptsTitle} pageDesc={t.pages.promptsDesc}>
    {
      /* 集合一条都没有时不摆检索框 —— 一个搜什么都搜不到的框，
        在界面上和"搜索坏了"长得一样。 */
    }
    {page.total > 0 && <CollectionSearch kind={SEARCH_KINDS.prompts} />}
    {
      /* 空状态是一个画出来的框，不是一个空 <ul>。paginate 在数据为空时照样生成第 1 页。 */
      page.data.length === 0 ? (
        <EmptyState message={t.pages.promptsEmpty} />
      ) : (
        <ul>
          {page.data.map(entry => (
            <Card {...entry} />
          ))}
        </ul>
      )
    }

    {
      /* 【2026-09-20】这里原来挂着一块投稿说明（`PromptSubmit.astro`：三步流程 +
       *  一句红线 + 一个 mailto 按钮），用户要求整块删掉，组件也一并删了。
       *
       *  ⚠ **投稿入口没有跟着消失，它挪进了这一页顶上那句说明**
       *    （`t.pages.promptsDesc`：「…欢迎通过网站底部的联系方式联系投稿。」）。
       *    这一条要紧：这个集合**收读者投稿**，而站上没有表单、没有服务端 ——
       *    页面上一个字都不提的话，"这个站不收投稿"和"入口没了"字节级相同，
       *    而后者没有任何人会发现（docs/engineering-notes.md 第二节最后那条）。
       *    改那句说明时别把后半句删掉。 */
    }
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
