---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { foldQaGroups } from "@/utils/qaGroups";
import { entrySlug, entryUrl } from "@/utils/getPostPaths";
import { agentDisplayName, findAgent } from "@/config/agents";
import { modelSlot, modelSlotLabel } from "@/config/models";
import {
  CONTENT_COLLECTIONS,
  requireCollectionSpec,
} from "@/config/collections";
import { XHS_HEIGHT, XHS_WIDTH } from "@/utils/xhsCardPlan";
import { QUEUE_GAP_DEFAULT_SEC, QUEUE_GAP_MAX_SEC } from "./xhsQueuePlan";
import { findPlatform } from "@/config/socialPlatforms";
import { logKey, publishedLabel, readPublished } from "./xhsPublished";
import { useTranslations } from "@/i18n";
import config from "@/config";

/**
 * 小红书封面图 —— `/_xhs`，**只在 `pnpm dev` 里存在**（和 /_gate、/_share 同一条路：
 * astro.config.ts 里按 isDev 用 injectRoute 挂上，文件不在 src/pages 下，
 * 生产构建里没有这条路由）。
 *
 * 【2026-09-22 用户要的】小红书发帖的载体是**图片**，不是文字。每条已发布的内容
 * 各生成一张 1080×1440（3:4）的封面卡，点一下下载，直接发。
 * 卡怎么画在 `src/utils/xhsCard.ts`，每一格印什么在 `src/utils/xhsCardPlan.ts`，
 * 出图那条接口是 `/_xhs/card.png`（`src/dev/xhs-card.ts`）。
 *
 * ## 和 `/_share` 是一对，而且**一样折叠**
 *
 * 同一个问题 / 同一个选题的几份折成**一张**卡，图上一行一个智能体 ——
 * 和那段发到 X 的话同一个形状（`sharePost.ts`）。钥匙是 `foldQaGroups()`，
 * 和列表卡片、详情页那排切换**同一把**。
 *
 * ★【2026-09-22 用户要的】这**推翻了第一版的设计**，原样记在这儿免得下一个人
 *   以为是漏改。第一版是"一条内容一张图、刻意不折"，理由是：
 *   「图上那行落款是这一条的『智能体（模型）』，折起来的话一张卡只能印代表
 *   那条的落款，而它旁边还有两条别人答的 —— 那是替另外两个智能体认领 /
 *   抹掉出处」。
 *   用户的原话是「内容只有一个模型的摘要，要像 X 发帖一样有多个模型的回答，
 *   字体小一点没关系」。
 *   ★ 关键是：**那个反对意见在新形态下不成立了** —— 现在每一行自己带着名字
 *   （`ChatGPT：<概括>`），而页脚那行落款在几份时**强制不画**
 *   （判据在 `planXhsCard()` 一处）。折叠之后比原来更准确，不是取舍掉了什么。
 *   ⚠ 所以别把"不折"改回来当成修 bug。
 *
 * ## 三档，不压
 *
 *   - 已发布：有公开地址，出图。
 *   - 草稿：**没有**公开地址（postFilter 不放行、页面不生成），单独列出来说明，
 *     不出图 —— 一张印着草稿内容的封面发出去，站上找不到对应的页面。
 *   - 一条都没有：说出来，别留一个空页面。
 *
 * 图本身还有第四档，在浏览器里：**画不出来**（中文字形取不到）那一格是红框 ＋
 * 一条能点开看原因的链接，不是一张兜底图。理由写在 `xhs-card.ts` 文件头 ——
 * 一张"看起来能发"的图会被真的发出去，而发出去收不回来。
 */

const locale = config.site.lang;
const t = useTranslations(locale);

/**
 * ⚠ `getCollection()` 要的是**字面量**集合名，所以这四行没法从登记表推 ——
 *   和 `/_share`、`/_xhs/card.png` 同一个限制、同一个补法：写出来，然后反过来对账。
 */
const posts = await getCollection("posts");
const qa = await getCollection("qa");
const guides = await getCollection("guides");
const prompts = await getCollection("prompts");

const BY_KEY: Record<string, { collection: string }[]> = {
  posts,
  qa,
  guides,
  prompts,
};

{
  const routed = CONTENT_COLLECTIONS.filter(c => c.urlPrefix !== null).map(
    c => c.key
  );
  const missing = routed.filter(k => !(k in BY_KEY));
  if (missing.length > 0) {
    throw new Error(
      `/_xhs 漏了集合：${missing.join(" / ")}。\n` +
        `上面补一行 getCollection("<集合>") 并加进 BY_KEY —— ` +
        `漏掉的那个集合在这一页上根本不出现，而页面照常渲染、一句话都不说。`
    );
  }
}

type Entry =
  | (typeof posts)[number]
  | (typeof qa)[number]
  | (typeof guides)[number]
  | (typeof prompts)[number];

const all: Entry[] = [...posts, ...qa, ...guides, ...prompts];
// getSortedPosts = postFilter：草稿不进来；dev 里未到时间的进来（docs/engineering-notes.md 坑 1）。
const published: Entry[] = getSortedPosts(all);
const drafts: Entry[] = all.filter(e => e.data.draft === true);

const str = (entry: Entry, key: string): string | undefined => {
  const v = (entry.data as Record<string, unknown>)[key];
  return typeof v === "string" && v !== "" ? v : undefined;
};

/**
 * 卡片底下那行落款 —— 和图上印的**是同一句**。
 *
 * ⚠ 这里和 `xhs-card.ts` 的 `bylineOf()` 各写了一份，是**刻意的**，
 *   但两份都只是在摆 `findAgent()` / `modelSlot()` / `modelSlotLabel()` 这几个
 *   全站唯一判据的结果 —— 真正会出错的那部分（哪一档、叫什么名字）只有一处。
 *   ★ 页面这一份存在的理由：**人要能不下载就分清挨着的三张同题卡是谁答的**。
 *     两份长得不一样的话屏幕上当场就看得出来（图上一句、图下一句，并排着），
 *     这是这个仓库里少有的"抄第二份反而被当场抓住"的位置。
 */
const bylineOf = (entry: Entry): string | undefined => {
  if (requireCollectionSpec(entry.collection).provenance !== "by-agent") {
    return undefined;
  }
  const agentId = str(entry, "agent");
  const label = agentDisplayName(agentId, t.qa.unspecifiedAgent);
  const model = modelSlotLabel(
    modelSlot(findAgent(agentId)?.kind, str(entry, "model")),
    t.qa.unspecifiedModel
  );
  return model ? `${label}（${model}）` : label;
};

const slugOf = (e: Entry) =>
  entrySlug(e.collection, e.id, e.filePath).replace(/^\/+/, "");

/** 工具栏那三个选择按钮共用的样式（和卡片上那两个按钮是同一副形状）。 */
const BAR_BTN =
  "border-border bg-surface hover:border-border-strong inline-flex items-center rounded-md border px-3 py-1.5 text-sm font-medium transition-colors";

/**
 * 【2026-09-22 用户要的】同一个问题 / 同一个选题**折成一张卡**，
 * 图上一行一个智能体（像 X 那段发帖文案）。
 *
 * ★ 钥匙是 `foldQaGroups()` —— 和列表卡片、详情页那排切换、`/_share` **同一把**
 *   （`related.ts` 的 `qaGroupKey()`）。在这儿另写一套"标题一样就算一组"，
 *   症状是站上折了、封面图没折（或者反过来），而四处全绿。
 */
const groups = foldQaGroups(published);

/** 哪几条我们已经发过 —— 三档，见 `xhsPublished.ts`。没发过的整行不画。 */
const publishedLog = readPublished();

/**
 * 「发小红书」那个按钮和批量队列**还该不该出现**。
 *
 * ★ 判据是**平台表里那一行的 `mode`**（`src/config/socialPlatforms.ts`），
 *   不是一个写死的开关：2026-09-23 停用，那一行是 `retired`，
 *   于是这一页上所有"替你按下发送"的入口一起消失。
 * ⚠ 认的是 `"xhs"` 这个 id 而不是遍历整张表，**这一处写死是对的**：
 *   `/_xhs/publish` 那条端点调的是 `xiaohongshu-mcp`，它本来就只会发小红书。
 *   哪天接了一个真有官方接口的平台（比如公众号），要新开一条端点，
 *   而不是把这个按钮指过去。
 * ★ **不许把这一格换成"永远 false"**：那样平台表就成了一句没人读的注释，
 *   而重新开张那天没有任何一处会跟着变（docs/engineering-notes.md 第一节那个 `scan.length === 1`）。
 */
const xhsPlatform = findPlatform("xhs");
const canAutoPublish = xhsPlatform?.mode === "official";

const items = groups.map(({ entry, answers }) => {
  const slug = slugOf(entry);
  const spec = requireCollectionSpec(entry.collection);
  return {
    key: `${entry.collection}/${slug}`,
    /** 发帖接口要的那两个参数（`/_xhs/publish` 按它们再查一次，页面不传内容过去）。 */
    collection: entry.collection,
    slug,
    /**
     * ★ 组里**每一条**的 key 都要留在卡上。后台那个「封面图」按钮带过来的是
     *   **当前正编辑那一条**的 slug，而折叠之后它可能不是代表 ——
     *   只认代表的话，从那几条点过来会落在页面顶上什么都不发生，
     *   而按钮照常能点、零报错（`/_share` 2026-09-21 踩过同一个形态）。
     */
    keys: answers.map(a => `${a.collection}/${slugOf(a)}`).join(" "),
    label: spec.label,
    title: entry.data.title,
    /** 只有一份时印落款；几份时印「几份、分别是谁」——和图上那几行对得上。 */
    byline: answers.length === 1 ? bylineOf(entry) : undefined,
    count: answers.length,
    countLabel: `${answers.length} ${entry.collection === "qa" ? "个回答" : "份报告"}`,
    /** 几份时把名字列出来：和图上那几行一一对应，不用下载就对得上。 */
    who: answers.map(a => bylineOf(a) ?? t.qa.unspecifiedAgent).join(" · "),
    href: entryUrl(entry.collection, entry.id, entry.filePath, locale),
    png: `/_xhs/card.png?c=${encodeURIComponent(entry.collection)}&s=${encodeURIComponent(slug)}`,
    /** 下载下来叫什么。带站名前缀，一堆图混在下载目录里还认得出是哪个站的。 */
    filename: `${config.site.title}-${spec.urlPrefix}${slug}.png`,
    /** 「已发过 ✓」/「发过，结果不确定」/「试过没成」/ undefined（没发过）。 */
    sent: publishedLabel(publishedLog[logKey(entry.collection, slug)]),
    sentTier: publishedLog[logKey(entry.collection, slug)]?.tier,
  };
});
---

<Layout title="封面图（仅 dev）">
  <Header />
  <Main
    pageTitle="封面图"
    pageDesc={`每条已发布的内容生成一张 ${XHS_WIDTH}×${XHS_HEIGHT}（3:4）的竖版封面卡，点「下载」拿走。同一个问题 / 同一个选题的几份折成一张，图上一行一个智能体。配套的那段字在「发帖文案」页。只在 pnpm dev 里存在。`}
  >
    {
      /* 两个数都报：「发了几条内容」和「要出几张图」是两件事。
         压成一个数的话，"同一个问题折成了一张"这件事在屏幕上完全看不出来
         （和 /_share 那一页同一条规矩）。 */
    }
    <p class="text-muted-foreground font-mono text-sm">
      已发布 {published.length} 条 · 合并成 {items.length} 张图 · 草稿 {
        drafts.length
      } 条
    </p>

    {
      /* 第一次打开要等：每张卡的中文字形是按**这张卡上的字**去 Google Fonts
         取子集的（docs/engineering-notes.md 坑 6 的解法），一张卡一次往返，之后就命中缓存了。
         不说这句的话，人会以为页面卡死了。 */
    }
    <p class="text-muted-foreground mt-2 text-sm">
      第一次打开每张图要现取一次中文字形（按这张卡上出现的字去取子集），会慢几秒；
      之后命中缓存就快了。图是滚到哪张才画哪张。
    </p>

    {
      items.length === 0 && (
        <div class="app-callout mt-4">
          <p class="font-semibold">还没有已发布的内容。</p>
          <p class="mt-1">
            草稿没有公开地址，所以也不出封面图 —— 先在后台取消草稿。
          </p>
        </div>
      )
    }

    {
      /* ★ 自动发帖那条路停了之后，**这儿必须说一句** —— 按钮静默消失的话，
           「不发小红书了」和「那个按钮坏了」在屏幕上字节级相同，
           而后者没有任何人会发现（docs/engineering-notes.md 第二节）。
         ★ 同时告诉人**现在该去哪儿**：光说没了等于把人晾在半路上。 */
    }
    {
      items.length > 0 && !canAutoPublish && xhsPlatform && (
        <div
          class="mt-6 rounded-md border p-3"
          style="border-color:#a16207"
          data-xhs-retired
        >
          <p class="text-sm font-semibold" style="color:#a16207">
            「发小红书」和批量队列已经撤掉了。
          </p>
          <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
            {xhsPlatform.modeWhy}
          </p>
          <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
            图还照出 —— 雪球 / 富途牛牛都收图。配套那段字去
            <a href="/_share" class="underline decoration-1 underline-offset-4">
              发帖文案
            </a>
            页复制，那边三家各有一份（判据在 src/config/socialPlatforms.ts）。
            <strong>那三家都没有官方发帖接口，最后一下人自己按。</strong>
          </p>
        </div>
      )
    }

    {
      /* ── 批量发布那条工具栏（【2026-09-22 用户要的】）────────────────────
         一条真发实测 54 秒，十几条就是十几分钟 —— 人不该坐在那儿一个个点。
         ★ 判据全在 `xhsQueuePlan.ts`（纯函数、有单测）：哪些能放心勾、
           什么结果要停整批、跑完那句话怎么分档。这儿只摆控件。
         ★ 钉在顶上（sticky）不是为了好看：队列一跑十几分钟，人会往下滚去看
           别的卡 —— 进度和那个「停止」跟着滚走的话，想停的时候找不着它。 */
    }
    {
      items.length > 0 && canAutoPublish && (
        <div
          data-xhs-bar
          class="border-border bg-surface sticky top-0 z-20 mt-6 rounded-md border p-3"
        >
          <div class="flex flex-wrap items-center gap-2">
            {/* ★ 「选没发出去的」排第一，它是最常用也最安全的那一个：
                判据 `safeToQueue()` —— 没记录 ＋ 明确失败过的才勾，
                **「不确定」那几条不勾**（可能已经在小红书上了，重发就是发重）。 */}
            <button type="button" data-xhs-sel="safe" class={BAR_BTN}>
              选没发出去的
            </button>
            <button type="button" data-xhs-sel="all" class={BAR_BTN}>
              全选
            </button>
            <button type="button" data-xhs-sel="none" class={BAR_BTN}>
              清空
            </button>
            <span
              data-xhs-count
              class="text-muted-foreground font-mono text-sm"
            />
            <span class="grow" />
            <label class="text-muted-foreground flex items-center gap-1 text-sm">
              每条之间隔
              <input
                type="number"
                data-xhs-gap
                value={QUEUE_GAP_DEFAULT_SEC}
                min="0"
                max={QUEUE_GAP_MAX_SEC}
                class="border-border bg-surface w-16 rounded border px-2 py-1 text-right font-mono text-sm"
              />
              秒
            </label>
            <button
              type="button"
              data-xhs-run
              class="border-border bg-surface hover:border-border-strong inline-flex items-center rounded-md border px-3 py-1.5 text-sm font-semibold transition-colors"
            >
              开始批量发布
            </button>
            <button
              type="button"
              data-xhs-stop
              hidden
              class="inline-flex items-center rounded-md border px-3 py-1.5 text-sm font-semibold transition-colors"
              style="border-color:#dc2626;color:#dc2626"
            >
              停止
            </button>
          </div>

          {/* ⚠ 这两句都不许删。
              ① 间隔那个数**是猜的**（小红书没公开发帖频率限制），把它说成知识
                 是这个项目最忌讳的那种假确定；
              ② 「停止」**停不掉正在发的那一条** —— 人默认会以为停止 = 取消，
                 于是以为那条没发出去、回头又发一遍。 */}
          <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
            串行发，上一条回来了才发下一条。间隔那个数<strong>是猜的</strong>
            —— 小红书没公开发帖频率限制，留它只是不想以机器速度连发；填 0
            就是不等。 「停止」只是<strong>不再发下一条</strong>
            ，正在发的那条拦不住（已经在路上了）。
          </p>

          <p
            data-xhs-queue-status
            role="status"
            aria-live="polite"
            class="mt-2 hidden text-sm leading-relaxed whitespace-pre-wrap"
          />
        </div>
      )
    }

    <ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map(item => (
          <li>
            <article
              id={item.key}
              data-xhs-keys={item.keys}
              data-xhs-item
              class="app-card flex h-full flex-col p-4"
            >
              {/* ★ 勾进这一批。**默认一个都不勾** —— 全勾的话一次误点就是
                  十几条真的发出去了，而发出去收不回来。常用的那一档由工具栏上
                  「选没发出去的」一键完成（判据 `safeToQueue()`）。
                  ⚠ `data-xhs-tier` 带的是流水账里那一档（没发过就是空串），
                    那个按钮**只**认它，不去猜卡片上的文字。 */}
              {canAutoPublish && (
                <label class="mb-2 inline-flex cursor-pointer items-center gap-2 text-xs">
                  <input
                    type="checkbox"
                    data-xhs-check
                    data-xhs-tier={item.sentTier ?? ""}
                    aria-label={`把「${item.title}」加进批量发布`}
                    class="size-4"
                  />
                  <span class="text-muted-foreground">加入批量</span>
                </label>
              )}

              {/* 预览。3:4 的位子先占好（aspect-[3/4]），图没到的时候版面不跳。
                  ★ onerror 那一档由下面的脚本接管：红框 + 一条能看原因的链接，
                    **不是**一张兜底图 —— 理由在 xhs-card.ts 文件头。 */}
              <div
                class="border-border bg-muted relative aspect-[3/4] w-full overflow-hidden rounded-md border"
                data-xhs-slot
              >
                <img
                  src={item.png}
                  alt={`${item.label}「${item.title}」的小红书封面图`}
                  width={XHS_WIDTH}
                  height={XHS_HEIGHT}
                  loading="lazy"
                  decoding="async"
                  data-xhs-img
                  data-xhs-href={item.png}
                  class="h-full w-full object-cover"
                />
              </div>

              <p class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="text-muted-foreground text-xs">{item.label}</span>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-semibold underline decoration-1 underline-offset-4"
                >
                  {item.title}
                </a>
                {/* 折了才挂角标。只有一份时挂一个「1 份报告」是噪音 —— 那是完成态。 */}
                {item.count > 1 && (
                  <span class="border-border text-muted-foreground rounded-md border px-2 py-0.5 text-xs">
                    {item.countLabel}
                  </span>
                )}
              </p>

              {/* ★ 这一行印的东西和图上**对得上**，两档：
                  一份 → 完整落款「某某（模型）」，和图的页脚是同一句；
                  几份 → 每一份是谁，和图上那几行一一对应。
                  没有这一维的集合（教程 / 提示词）整行不画 —— 印一句
                  「来源未标注」是在说"这里本该填而没填"，而它们压根没有这一格。 */}
              {(item.byline ?? (item.count > 1 ? item.who : undefined)) && (
                <p class="text-muted-foreground mt-1 text-xs">
                  {item.byline ?? item.who}
                </p>
              )}

              {/* ★ 发过没发过 —— 三档，措辞和颜色两两不同（见 xhsPublished.ts）。
                  中间那档不许省：显示成「已发过」你不会去补发一条其实没发出去的；
                  显示成「没发过」你可能发重。没发过整行不画，那是完成态。 */}
              {item.sent && (
                <p
                  class="mt-2 text-xs"
                  style={
                    item.sentTier === "published"
                      ? "color:#15803d"
                      : item.sentTier === "failed"
                        ? "color:#dc2626"
                        : "color:#a16207"
                  }
                >
                  {item.sent}
                </p>
              )}

              <p class="mt-3 flex flex-wrap items-center gap-2">
                <a
                  href={item.png}
                  download={item.filename}
                  class="border-border bg-surface hover:border-border-strong inline-flex items-center rounded-md border px-3 py-1.5 text-sm font-medium no-underline transition-colors"
                >
                  下载 PNG
                </a>
                {/* ★【2026-09-22 用户要的】直接发，不停在发布页等确认。
                    结果**四档**，屏幕上两两不同 —— 那个接口没有公开的响应 schema，
                    "看不懂"不许粉饰成绿的（见 src/dev/xhsPublishPlan.ts）。
                    ⚠【2026-09-23】停用，这个按钮跟着平台表那一行一起收起来了
                    （`canAutoPublish`）。撤掉的原因印在上面那个琥珀框里，
                    不是让它静默消失。 */}
                {canAutoPublish && (
                  <button
                    type="button"
                    data-xhs-publish
                    data-xhs-c={item.collection}
                    data-xhs-s={item.slug}
                    class="border-border bg-surface hover:border-border-strong inline-flex items-center rounded-md border px-3 py-1.5 text-sm font-medium transition-colors"
                  >
                    发小红书
                  </button>
                )}
                <a
                  href={item.png}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted-foreground text-sm underline decoration-1 underline-offset-4"
                >
                  原图 ↗
                </a>
              </p>
              <p
                data-xhs-status
                role="status"
                aria-live="polite"
                class="mt-2 hidden text-xs leading-relaxed whitespace-pre-wrap"
              />
              {/* 回包原文。`unconfirmed` 那一档全靠它 —— 人拿它去小红书比对，
                  确认发出去了就把那句成功提示加进 SUCCESS_SIGNALS。 */}
              <pre
                data-xhs-raw
                class="border-border bg-muted mt-2 hidden max-h-40 overflow-auto rounded border p-2 font-mono text-[11px] whitespace-pre-wrap"
              />
            </article>
          </li>
        ))
      }
    </ul>

    {
      drafts.length > 0 && (
        <section class="mt-10">
          <h2 class="mb-2 text-lg font-semibold">
            草稿（没有公开地址，不出图）
          </h2>
          <ul class="text-muted-foreground space-y-1 font-mono text-sm">
            {drafts.map(d => (
              <li>{d.data.title}</li>
            ))}
          </ul>
        </section>
      )
    }
  </Main>
  <Footer />
</Layout>

<script>
  import {
    asQueueState,
    parseGapSeconds,
    queueProgress,
    queueSummary,
    queuedLabel,
    recordedTier,
    safeToQueue,
    skippedLabel,
    stopsQueue,
    type QueueEndState,
    type StopReason,
  } from "./xhsQueuePlan";

  /**
   * 画不出来的那一格：红框 ＋ 一条「看看为什么」。
   *
   * ★ 三档在屏幕上长得不一样：**图出来了** / **还在转**（浏览器自己的占位）/
   *   **出不来**（红框）。第三档绝不许退化成"一张看起来能发的图" ——
   *   端点那边也刻意不回落（见 src/dev/xhs-card.ts 文件头）。
   * ⚠ `<img>` 的 error 事件**不冒泡**，所以只能逐个挂，不能在 document 上代理。
   */
  function markBroken(img: HTMLImageElement) {
    const slot = img.closest<HTMLElement>("[data-xhs-slot]");
    if (!slot || slot.dataset.xhsBroken === "1") return;
    slot.dataset.xhsBroken = "1";
    slot.style.borderColor = "#dc2626";
    slot.style.borderStyle = "dashed";

    const box = document.createElement("div");
    box.className =
      "absolute inset-0 flex flex-col items-center justify-center gap-2 p-4 text-center text-sm";
    box.style.color = "#dc2626";

    const line = document.createElement("p");
    line.textContent = "这张图没画出来";
    line.style.fontWeight = "600";

    const why = document.createElement("a");
    why.href = img.dataset.xhsHref ?? img.src;
    why.target = "_blank";
    why.rel = "noopener noreferrer";
    why.textContent = "看看为什么 ↗";
    why.style.textDecoration = "underline";

    box.append(line, why);
    img.remove();
    slot.append(box);
  }

  /**
   * 「发小红书」那个按钮。结果**四档，屏幕上两两不同** ——
   * 那个接口没有公开的响应 schema，所以 `unconfirmed`（调通了但看不懂回包）
   * 是独立一档，**不许粉饰成绿的**，而且要把回包原文摊出来
   * （见 src/dev/xhsPublishPlan.ts 文件头）。
   */
  const TIER_STYLE: Record<string, { color: string; head: string }> = {
    published: { color: "#15803d", head: "✓ 发出去了" },
    unconfirmed: {
      color: "#a16207",
      head: "？不确定发出去没有 —— 去小红书看一眼",
    },
    failed: { color: "#dc2626", head: "✗ 没发出去" },
    offline: { color: "#a16207", head: "— 还没轮到发布" },
  };

  /**
   * 发布中那几十秒里页面上说什么。
   *
   * 【2026-09-22 用户报的】第一次真发实测 **54 秒**，而这中间页面只有一句
   * 「发布中…」—— 用户原话「一直处在发布中，看不到详细日志和状态」。
   * **"正在干活"和"已经挂了"在屏幕上长得一模一样**，那正是这个项目最忌讳的。
   *
   * ★ 这几段时间是**从那次真实日志里量的**（开浏览器 5s → 传图 12s →
   *   填正文 30s → 等发布按钮 5s），不是拍脑袋编的。
   * ⚠ 但它仍然是**预估**，不是真实进度 —— MCP server 的日志在它自己的 stdout 里，
   *   页面拿不到。所以屏幕上**必须写明这是预估**（见 `tick()` 里那一行）：
   *   一个假装知道进度的进度条，比没有进度更坏。
   * ★ **已用秒数是真的** —— 那是这块唯一一个如实的数字，卡住没卡住靠它判断。
   */
  const PUBLISH_STEPS: { at: number; text: string }[] = [
    { at: 0, text: "查登录、出图" },
    { at: 8, text: "上传图片" },
    { at: 22, text: "填写正文和标签" },
    { at: 50, text: "等发布按钮，准备提交" },
    {
      at: 75,
      text: "比上次实测（54 秒）久了 —— 可能在等验证码，去浏览器看一眼",
    },
  ];

  function stepAt(sec: number): string {
    let cur = PUBLISH_STEPS[0]!.text;
    for (const s of PUBLISH_STEPS) if (sec >= s.at) cur = s.text;
    return cur;
  }

  /**
   * 发一条。
   *
   * ★ **单点那个按钮和批量队列走的是同一个函数。** 各写一份的那天，两条路会
   *   慢慢长成两套行为（一边把 403 当 unconfirmed、另一边当 failed 之类），
   *   而屏幕上没有任何一处会说它们不一样 —— 同 `xhsEntry.ts` 那条理由。
   *
   * @returns `tier` 是四档之一（认不出的原样带出来）；
   *   `fatal` = **连自己的 dev server 都请求不到了**，后面每一条都会一样，
   *   批量那边据此整批停下（它和 `offline` 是两种原因，屏幕上分得开）。
   */
  async function publishOne(
    card: HTMLElement
  ): Promise<{ tier: string; fatal: boolean }> {
    const btn = card.querySelector<HTMLButtonElement>("[data-xhs-publish]");
    const status = card.querySelector<HTMLElement>("[data-xhs-status]");
    const raw = card.querySelector<HTMLElement>("[data-xhs-raw]");
    if (!btn || !status || !raw) return { tier: "failed", fatal: false };

    const wasDisabled = btn.disabled;
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = "发布中…";
    status.hidden = false;
    status.style.color = "";
    raw.hidden = true;

    // 秒表 + 预估步骤。⚠ 那句「按上次实测推的」不许删，见 PUBLISH_STEPS。
    const started = Date.now();
    const tick = () => {
      const sec = Math.round((Date.now() - started) / 1000);
      status.textContent =
        `发布中 · 已用 ${sec} 秒\n` +
        `这会儿大概在：${stepAt(sec)}\n` +
        `（步骤是按上次实测的节奏推的，不是真实进度；秒数是真的）`;
    };
    tick();
    const timer = window.setInterval(tick, 1000);

    try {
      const res = await fetch("/_xhs/publish", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Requested-With": "lwj-xhs",
        },
        body: JSON.stringify({ c: btn.dataset.xhsC, s: btn.dataset.xhsS }),
      });
      const text = await res.text();
      let data: {
        tier?: string;
        detail?: string;
        raw?: string;
        note?: { title?: string; body?: string; tags?: string[] };
      };
      try {
        data = JSON.parse(text);
      } catch {
        // ⚠ 接口没回 JSON（403 那一档就是纯文本）—— 那也是一种"看不懂"，
        //   照实说，别当成失败也别当成成功。
        data = { tier: "unconfirmed", detail: text.slice(0, 500) };
      }

      const tier = TIER_STYLE[data.tier ?? ""] ?? {
        color: "#a16207",
        head: `？认不出的结果：${data.tier}`,
      };
      status.style.color = tier.color;
      status.textContent = `${tier.head}\n${data.detail ?? ""}`;

      // 发出去的那份文案 ＋ 回包原文都摊出来：`unconfirmed` 那一档人要拿它比对。
      const parts = [
        data.note &&
          `标题（${[...(data.note.title ?? "")].length}/20）：${data.note.title}\n` +
            `标签：${(data.note.tags ?? []).join(" / ") || "（无）"}\n\n` +
            data.note.body,
        data.raw && `— 接口回包 —\n${data.raw}`,
      ].filter(Boolean);
      if (parts.length > 0) {
        raw.hidden = false;
        raw.textContent = parts.join("\n\n");
      }
      return { tier: data.tier ?? "", fatal: false };
    } catch (err) {
      status.style.color = "#dc2626";
      status.textContent = `✗ 请求没发出去：${String(err)}`;
      return { tier: "failed", fatal: true };
    } finally {
      // ⚠ 秒表必须在这儿停：不停的话它会一直盖掉刚写上去的结果，
      //   屏幕上永远是"发布中"，而请求其实早就回来了。
      window.clearInterval(timer);
      // ⚠ 批量跑的时候这几个按钮是**整批禁用**的，这儿不许无条件放开：
      //   放开了人就能在队列还在跑的时候点单条，撞上接口那把 running 锁，
      //   拿到一条 409「上一条还没发完」—— 一次假的失败。
      btn.disabled = wasDisabled;
      btn.textContent = label;
    }
  }

  function bindPublish() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-xhs-publish]")
      .forEach(btn => {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";
        const card = btn.closest<HTMLElement>("[data-xhs-item]");
        if (!card) return;
        btn.addEventListener("click", () => void publishOne(card));
      });
  }

  /* ── 批量发布（【2026-09-22 用户要的】）─────────────────────────────────
     判据全在 `./xhsQueuePlan.ts`（纯函数、有单测）；这儿只有 DOM 和时序。 */

  /** 正在跑一批没有。⚠ 全局一个 —— 两批同时跑会撞上接口那把 running 锁。 */
  let queueRunning = false;
  /** 人按了停止。★ 它只让**下一条**不发，拦不住正在路上的那一条。 */
  let stopRequested = false;

  const allCards = () => [
    ...document.querySelectorAll<HTMLElement>("[data-xhs-item]"),
  ];
  const checkOf = (card: HTMLElement) =>
    card.querySelector<HTMLInputElement>("[data-xhs-check]");
  const titleOf = (card: HTMLElement) =>
    card.querySelector("a")?.textContent?.trim() ?? "";

  /** 往卡片那行状态里写一句（排队中 / 没轮到都走它，和发布结果同一个位置）。 */
  function note(card: HTMLElement, text: string, color: string) {
    const el = card.querySelector<HTMLElement>("[data-xhs-status]");
    if (!el) return;
    el.hidden = false;
    el.style.color = color;
    el.textContent = text;
  }

  function bar<T extends HTMLElement>(sel: string) {
    return document.querySelector<T>(`[data-xhs-bar] ${sel}`);
  }

  /** 工具栏那句话。队列没跑的时候整行不画 —— 那是完成态，不是"无消息"。 */
  function say(text: string | undefined, color = "") {
    const el = bar<HTMLElement>("[data-xhs-queue-status]");
    if (!el) return;
    el.hidden = text === undefined;
    el.style.color = color;
    el.textContent = text ?? "";
  }

  /**
   * 「已选 N 张」。⚠ 两档：**一张都没选**要说出来，而且「开始」那个按钮
   * 跟着禁用 —— 否则按下去什么都不发生，和"坏了"长得一样。
   */
  function updateCount() {
    const n = allCards().filter(c => checkOf(c)?.checked).length;
    const el = bar<HTMLElement>("[data-xhs-count]");
    if (el) el.textContent = n === 0 ? "一张都没选" : `已选 ${n} 张`;
    const run = bar<HTMLButtonElement>("[data-xhs-run]");
    if (run && !queueRunning) run.disabled = n === 0;
  }

  /**
   * 卡片上带的那一档（流水账里的）。
   * ⚠ **空属性是 `undefined`（没发过），不是走 `asQueueState()`** ——
   *   那个函数把认不出的东西归成 `unconfirmed`，而"没发过"恰恰相反：
   *   它是唯一一个可以放心发的状态。混进去的话「选没发出去的」会把
   *   **一张都不勾**，而按钮照常能点、零报错。
   */
  const tierOf = (box: HTMLInputElement) => {
    const raw = box.dataset.xhsTier ?? "";
    return raw === "" ? undefined : asQueueState(raw);
  };

  function select(mode: "all" | "none" | "safe") {
    for (const card of allCards()) {
      const box = checkOf(card);
      if (!box) continue;
      box.checked =
        mode === "all"
          ? true
          : mode === "none"
            ? false
            : // ★ 判据只有一处（`safeToQueue`）：没记录 ＋ 明确失败过的才勾，
              // 「不确定」那几条不勾 —— 重发它们就是可能发重。
              safeToQueue(tierOf(box));
    }
    updateCount();
  }

  /** 队列跑起来之后，能改动这一批的控件全锁上，只留「停止」。 */
  function setBusy(busy: boolean) {
    queueRunning = busy;
    for (const card of allCards()) {
      const box = checkOf(card);
      if (box) box.disabled = busy;
      const btn = card.querySelector<HTMLButtonElement>("[data-xhs-publish]");
      // ⚠ 队列跑的时候单条那个按钮必须禁掉：点了会撞上接口那把 running 锁，
      //   拿回一条 409「上一条还没发完」—— 屏幕上是一次凭空的失败。
      if (btn) btn.disabled = busy;
    }
    document
      .querySelectorAll<HTMLButtonElement | HTMLInputElement>(
        "[data-xhs-bar] [data-xhs-sel], [data-xhs-bar] [data-xhs-gap]"
      )
      .forEach(el => (el.disabled = busy));
    const run = bar<HTMLButtonElement>("[data-xhs-run]");
    if (run) {
      run.disabled = busy;
      run.textContent = busy ? "发布中…" : "开始批量发布";
    }
    const stop = bar<HTMLButtonElement>("[data-xhs-stop]");
    if (stop) {
      stop.hidden = !busy;
      stop.disabled = false;
      stop.textContent = "停止";
    }
    if (!busy) updateCount();
  }

  /** 两条之间那个间隔。返回 false = 中途被按了停止。 */
  function waitGap(
    sec: number,
    tell: (left: number) => void
  ): Promise<boolean> {
    return new Promise(resolve => {
      let left = sec;
      tell(left);
      const t = window.setInterval(() => {
        if (stopRequested) {
          window.clearInterval(t);
          resolve(false);
          return;
        }
        left -= 1;
        tell(left);
        if (left <= 0) {
          window.clearInterval(t);
          resolve(true);
        }
      }, 1000);
    });
  }

  async function runQueue() {
    if (queueRunning) return;
    const picked = allCards().filter(c => checkOf(c)?.checked);
    if (picked.length === 0) return;

    stopRequested = false;
    setBusy(true);
    const gap = parseGapSeconds(
      bar<HTMLInputElement>("[data-xhs-gap]")?.value ?? ""
    );

    /**
     * 先把整批标成「排队中 · 第 n/N 个」。
     * ★ 这一步不是装饰：不标的话，还没轮到的那些和**没勾**的长得一模一样，
     *   而它们正是人最想知道状态的那几张。
     */
    picked.forEach((card, i) =>
      note(card, queuedLabel(i + 1, picked.length), "#6b7280")
    );

    /** 每张卡最后停在哪一档。键上没有 = 还没轮到。 */
    const ended = new Map<HTMLElement, QueueEndState>();
    let stopReason: StopReason | undefined;

    for (let i = 0; i < picked.length; i++) {
      const card = picked[i]!;
      if (stopRequested) {
        stopReason = "stopped";
        break;
      }
      say(queueProgress(i, picked.length, titleOf(card)));

      const { tier, fatal } = await publishOne(card);
      const state = asQueueState(tier);
      ended.set(card, state);

      if (fatal) {
        stopReason = "transport";
        break;
      }
      // ★ 只有 `offline` 停整批（后面每条都会撞同一堵墙）；单条失败不停。
      if (stopsQueue(state)) {
        stopReason = "offline";
        break;
      }
      if (stopRequested) {
        stopReason = "stopped";
        break;
      }

      // 最后一条后面不用等。
      if (i < picked.length - 1 && gap > 0) {
        say(
          queueProgress(i + 1, picked.length, undefined) +
            ` · 歇 ${gap} 秒再发下一条`
        );
        const done = await waitGap(gap, left =>
          say(
            `队列 ${i + 1}/${picked.length} · ${left} 秒后发下一条（间隔是猜的，可以填 0）`
          )
        );
        if (!done) {
          stopReason = "stopped";
          break;
        }
      }
    }

    // 没轮到的那些：**独立一档**，而且说出为什么（三种原因两两不同）。
    const reason = stopReason ?? "stopped";
    for (const card of picked) {
      if (ended.has(card)) continue;
      ended.set(card, "skipped");
      note(card, skippedLabel(reason), "#a16207");
    }

    say(queueSummary(picked.map(c => ended.get(c) ?? "skipped")));

    /**
     * ★ 跑完之后**只留下"可以放心再发一次"的那几张**还勾着
     *   （判据还是 `safeToQueue`，和「选没发出去的」是同一个）：
     *   再按一次「开始」正好重试真没发出去的那些，而不会把已经发出去的
     *   和"不确定"的再发一遍。
     * ⚠ 卡上记哪一档走 `recordedTier()` —— 它和 `recordPublish()` 一致，
     *   `offline` / 没轮到都**不记**。记了的话卡片上带着一个盘上不存在的状态，
     *   刷新前后「选没发出去的」勾出来的东西不一样，而两次都不报错。
     */
    for (const card of picked) {
      const box = checkOf(card);
      if (!box) continue;
      const tier = recordedTier(ended.get(card) ?? "skipped");
      box.dataset.xhsTier = tier ?? "";
      box.checked = safeToQueue(tier);
    }

    setBusy(false);
  }

  function bindQueue() {
    const barEl = document.querySelector<HTMLElement>("[data-xhs-bar]");
    if (!barEl || barEl.dataset.bound === "1") return;
    barEl.dataset.bound = "1";

    barEl.querySelectorAll<HTMLButtonElement>("[data-xhs-sel]").forEach(b => {
      b.addEventListener("click", () =>
        select(b.dataset.xhsSel as "all" | "none" | "safe")
      );
    });
    for (const card of allCards()) {
      checkOf(card)?.addEventListener("change", updateCount);
    }
    barEl
      .querySelector<HTMLButtonElement>("[data-xhs-run]")
      ?.addEventListener("click", () => void runQueue());

    const stop = barEl.querySelector<HTMLButtonElement>("[data-xhs-stop]");
    stop?.addEventListener("click", () => {
      stopRequested = true;
      // ⚠ 措辞必须说清楚它停不掉正在发的那条 —— 人默认会以为停止 = 取消，
      //   于是以为那条没发出去、回头又发一遍。
      stop.textContent = "停下来了（正在发的那条还在跑完）";
      stop.disabled = true;
    });

    updateCount();
  }

  /**
   * 队列跑着的时候关页面 / 刷新 = 剩下那些永远不会发了，而已经发出去的
   * 那几条你也看不到结果了（流水账里还记着，刷新后卡片上那行会说）。
   */
  window.addEventListener("beforeunload", e => {
    if (!queueRunning) return;
    e.preventDefault();
  });

  function bind() {
    bindPublish();
    bindQueue();
    document
      .querySelectorAll<HTMLImageElement>("[data-xhs-img]")
      .forEach(img => {
        if (img.dataset.bound === "1") return;
        img.dataset.bound = "1";
        img.addEventListener("error", () => markBroken(img));
        /**
         * ⚠ 懒加载的图在绑监听之前就可能已经失败了（`complete` 为真而
         *   `naturalWidth` 是 0）—— 那时 error 事件早就过去了，只挂监听
         *   会让那一格永远停在空白占位上，零报错。
         */
        if (img.complete && img.naturalWidth === 0) markBroken(img);
      });
  }

  /** 从后台带 `#posts/<slug>` 过来：滚到那一条并框一下。和 /_share 同一套。 */
  function focusHash() {
    const key = decodeURIComponent(location.hash.slice(1));
    if (!key) return;
    const cards = [
      ...document.querySelectorAll<HTMLElement>("[data-xhs-item]"),
    ];
    /**
     * ★ 认的是 `data-xhs-keys`（**组里每一条**的 key，空格分隔），不是元素 id。
     *   折叠之后非代表那几条的 slug 不再是任何元素的 id —— 只查 id 的话，
     *   从那几条点「封面图」过来会落在页面顶上、什么都不发生，而按钮照常能点、
     *   一句报错都没有（`/_share` 2026-09-21 实测踩过这个形态）。
     * ⚠ 用 JS 比对而不是拼 `[data-xhs-keys~="…"]` 选择器：key 里有斜杠、
     *   而且是从地址栏来的，拼进选择器就得考虑转义；比字符串没有这回事。
     */
    const el = cards.find(c =>
      (c.dataset.xhsKeys ?? "").split(" ").includes(key)
    );
    if (!el) return;
    // 先把上一次那个框擦掉 —— hashchange 能反复触发，不擦的话屏幕上会有好几个框，
    // 而"当前是哪一条"正是这个框存在的理由。
    for (const c of cards) c.style.outline = "";
    el.scrollIntoView({ block: "center" });
    el.style.outline = "2px solid currentColor";
    el.style.outlineOffset = "4px";
  }

  bind();
  focusHash();
  document.addEventListener("astro:page-load", () => {
    bind();
    focusHash();
  });
  /**
   * ★ `hashchange` 是**必须的**（和 /_share 同一条，那边实测过）：这一页已经开着的时候
   *   再从后台点另一条，地址只有 `#` 后面变了，**页面不重新加载、astro:page-load
   *   也不触发**，症状是点了毫无反应、零报错。
   */
  window.addEventListener("hashchange", focusHash);
</script>
