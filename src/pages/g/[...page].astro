---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import EmptyState from "@/components/EmptyState.astro";
import CollectionSearch from "@/components/CollectionSearch.astro";
import { SEARCH_KINDS } from "@/config/searchKinds";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

/**
 * 教程列表页。形状和 `qa/[...page].astro`、`posts/[...page].astro` **逐行同构** ——
 * 教程本质就是一篇带图的文章，没有理由长成另一副样子。
 *
 * ★ 文件名里的 `[...page]` 是硬性的：Astro 把分页参数名写死成字符串 "page"，
 *   路由里没有这一段时 `paginate()` 直接抛 PageNumberParamNotFound。
 *   改名成 `index.astro` 会让整个 /guides 在构建期炸掉。
 */
export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getCollection("guides", ({ data }) => !data.draft);

  // ★ 必须过 getSortedPosts()：它内部的 postFilter 是「草稿 / 定时未到的条目
  //   不生成页面」的**唯一**机制（docs/engineering-notes.md 坑 1）。
  return paginate(getSortedPosts(entries), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.guidesTitle} | ${config.site.title}`}
  description={t.pages.guidesDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.guidesTitle} pageDesc={t.pages.guidesDesc}>
    {
      /* 集合一条都没有时不摆检索框 —— 一个搜什么都搜不到的框，
        在界面上和"搜索坏了"长得一样。 */
    }
    {page.total > 0 && <CollectionSearch kind={SEARCH_KINDS.guides} />}
    {
      /* 空状态是一个画出来的框，不是一个空 <ul>。paginate 在数据为空时照样生成第 1 页。
         为什么是框不是一行灰字，见 EmptyState.astro 的头注释。 */
      page.data.length === 0 ? (
        <EmptyState message={t.pages.guidesEmpty} />
      ) : (
        <ul>
          {page.data.map(entry => (
            <Card {...entry} />
          ))}
        </ul>
      )
    }
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
