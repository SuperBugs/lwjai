---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { breadcrumbTrail } from "@/utils/breadcrumb";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

/**
 * 首页后面那几格印什么、链到哪 —— 判据全在 `src/utils/breadcrumb.ts`，这里只管画。
 *
 * ★【2026-09-23 修】这里原来有一张手写的「路径段 → 中文名」表和一份手写的分页集合名单，
 *   键还是 2026-09-21 改地址之前的 posts / tags / about……于是 /r 印成「首页 / r」、
 *   /se 印成「首页 / se」，整整两天四处全绿（表查不中就原样输出路径段，不报错）。
 *   现在首段的名字从登记表推（collections.ts 的 urlPrefix + routes.ts 的 ROUTES），
 *   `scripts/gate/breadcrumb.test.ts` 钉着：**别在这个文件里再点名任何一个路径段**，
 *   也别再写 `t.nav.<某一格>` —— 除了「首页」，每一格的名字都从那张表来。
 */
const crumbs = breadcrumbTrail(currentUrlPath, {
  nav: t.nav,
  page: t.pagination.page,
});
---

{
  /* ★ 分隔符从 `»` 换成 `/`，层级色从 `opacity-*` 换成 `--muted-foreground`
   *  （2026-09-18 改）。两件事各有理由：
   *
   *  ① `»` 是西文的引导符，夹在中文词之间（「首页 » 研究」）字重和字宽都不搭，
   *     而且和正文里真实的书名号 `《》` 形近。`/` 是路径分隔符的通用记号
   *     （GitHub、Stripe、Vercel 的面包屑都用它），读者一眼知道这是地址结构。
   *  ② `opacity` 是把**整个元素**连同它的焦点框一起调淡 —— 键盘用户 Tab 到
   *     面包屑上时，那圈焦点虚线也跟着变成 70% 透明。改成直接给颜色，
   *     焦点框保持满强度。 */
}
<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="text-muted-foreground flex flex-wrap items-center gap-x-1.5 text-sm"
  >
    <li class="flex items-center gap-x-1.5">
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="hover:text-foreground transition-colors"
      >
        {t.nav.home}
      </a>
      <span aria-hidden="true">/</span>
    </li>
    {
      crumbs.map((crumb, index) =>
        index + 1 === crumbs.length ? (
          <li>
            <span
              class:list={[
                "text-foreground capitalize",
                { lowercase: index > 0 },
              ]}
              aria-current="page"
            >
              {/* make the last part lowercase in Home > Tags > some-tag */}
              {crumb.label}
            </span>
          </li>
        ) : (
          <li class="flex items-center gap-x-1.5">
            <a
              href={getRelativeLocaleUrl(locale, crumb.path)}
              class="hover:text-foreground capitalize transition-colors"
            >
              {crumb.label}
            </a>
            <span aria-hidden="true">/</span>
          </li>
        )
      )
    }
  </ul>
</nav>
