---
import { getRelativeLocaleUrl } from "astro:i18n";
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { SEARCH_FILTER_KEY } from "@/config/searchKinds";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `search` feature is not enabled
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const backUrl = config.features.showBackButton
  ? `${Astro.url.pathname}`
  : getRelativeLocaleUrl(locale, "");

const pagefindBundlePath = getAssetPath("pagefind/");

const t = useTranslations(locale);
---

{
  /* ★ noindex：搜索页是工具，不是内容；带 ?q= 的地址无穷多，收进去全是重复页。
     astro.config.ts 的 sitemap filter 同时把 /search/ 排除了 —— 两处要一起改，
     只 noindex 不排除 = sitemap 列着一个自己声明不要收录的地址（seo.test.ts 钉着两处）。 */
}
<Layout
  title={`${t.pages.searchTitle} | ${config.site.title}`}
  description={t.pages.searchDesc}
  robots="noindex, follow"
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc}>
    {
      /* ★ 文案在服务端拼好塞进 data-*，脚本只管读（和 CollectionSearch 同一套做法）——
         下面那段是**客户端 script**，拿不到 frontmatter 里的 `t`。
         键名是 Pagefind 规定的 snake_case，不是我们的命名风格：
         写错一个键**不报错**，只是那一句静默回落成英文。 */
    }
    <div
      id="pagefind-search"
      transition:persist
      data-backurl={backUrl}
      data-bundle-path={pagefindBundlePath}
      data-filter-key={SEARCH_FILTER_KEY}
      data-translations={JSON.stringify({
        placeholder: t.a11y.searchPlaceholder,
        clear_search: t.searchUi.clearSearch,
        load_more: t.searchUi.loadMore,
        search_label: t.searchUi.searchLabel,
        filters_label: t.searchUi.filtersLabel,
        zero_results: t.searchUi.zeroResults,
        many_results: t.searchUi.manyResults,
        one_result: t.searchUi.oneResult,
        alt_search: t.searchUi.altSearch,
        search_suggestion: t.searchUi.searchSuggestion,
        searching: t.searchUi.searching,
      })}
    >
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  // 地址栏里那个参数名（`/se?q=TSLA`）。首页全站框回车提交时的 <input name>、
  // 「搜全站」「查看全部」两条链接都按它拼 —— 各写一份的话，改了一处，
  // 从首页回车过来的读者就落在一个空框上，而四处全绿（search.test.ts 钉着）。
  import { SEARCH_QUERY_PARAM, searchResultHref } from "@/utils/searchBox";

  /** PagefindUI 交给 processResult 的那一份里，这里真正改到的字段。 */
  type PagefindUiResult = {
    url: string;
    sub_results?: { url: string }[];
  };

  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    if (!pageFindSearch) return;

    const bundlePath = pageFindSearch?.dataset?.bundlePath;
    if (!bundlePath) return;

    const params = new URLSearchParams(window.location.search);

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Display warning inn dev mode
      if (import.meta.env.DEV) {
        pageFindSearch.innerHTML = `
            <div class="bg-muted/75 rounded p-4 space-y-4 mb-4">
              <p><strong>DEV mode Warning! </strong>You need to build the project at least once to see the search results during development.</p>
              <code class="block bg-black text-white px-2 py-1 rounded">pnpm run build</code>
            </div>
          `;
      }

      // Init pagefind ui
      const search = new PagefindUI({
        element: "#pagefind-search",
        bundlePath,
        showImages: false,
        showSubResults: true,

        // ★ 不传这一项，PagefindUI 就用它内置的英文 —— 一个中文站的搜索页上
        //   写着「1 result for 研究」和一个「Clear」按钮。
        //   ⚠ 这件事**只有构建之后才看得见**：dev 里这一页永远是上面那条
        //     "DEV mode Warning"，PagefindUI 根本不初始化。
        translations: JSON.parse(pageFindSearch.dataset.translations ?? "{}"),

        // ★ 分面筛选「研究 / 问答 / 教程」。
        //   这里的配置是**通用的**（只说"按那个键分面"），分面里有哪几档
        //   完全由详情页上的标注决定 —— 所以新增集合时这一行不用动：
        //     src/pages/posts/[...slug]/index.astro   → data-pagefind-filter="类型:研究"
        //     src/pages/qa/[...slug]/index.astro      → data-pagefind-filter="类型:问答"
        //     src/pages/guides/[...slug]/index.astro  → data-pagefind-filter="类型:教程"
        //   **标注和这里的配置缺一不生效，而且两边都不报错** ——
        //   只标不配：索引里有分面，界面上没有入口；
        //   只配不标：界面上什么都不显示（Pagefind 只渲染索引里真实存在的分面）。
        //   两种情况下搜索都照常返回结果，`pnpm build` 也是绿的，
        //   所以改动这两处里的任何一处都要把另一处一起看。
        //   改完必须 `pnpm build` 一次才看得见效果：Pagefind 的索引是构建产物，
        //   dev 里这一页永远是那条 "DEV mode Warning"。
        //   ⚠ 键名从 data-* 读，不在这里写第二份字面量 ——
        //     这是客户端 script，import 不到 SEARCH_FILTER_KEY。
        openFilters: [pageFindSearch.dataset.filterKey],

        // 命中 0 的那一档**保留着显示成 0**，不要 hide 掉（这是 Pagefind 的默认值，
        // 写出来是为了说明它是有意的）。
        // 「这个查询下没有问答」和「这个站没有问答这种东西」是两件事 ——
        // 把前者藏起来就等于把它显示成后者（docs/engineering-notes.md 第二节）。
        showEmptyFilters: true,

        // ★【2026-09-23 实测】Pagefind 的地址带末尾斜杠（/r/1036/），全站口径不带 ——
        //   不换的话本地每条结果都是 404、线上每条都先 307 一次。判据在 searchBox.ts，
        //   和两个检索框读同一份。子结果（锚点那几条）要一起换：PagefindUI 拿
        //   第一条子结果的地址和 url 比相等来认"这是不是页面本身"，只换一边就认不出了。
        processResult: function (result: PagefindUiResult) {
          result.url = searchResultHref(result.url);
          result.sub_results?.forEach(sub => {
            sub.url = searchResultHref(sub.url);
          });
          return result;
        },
        processTerm: function (term: string) {
          params.set(SEARCH_QUERY_PARAM, term); // Update the `q` parameter in the URL
          history.replaceState(history.state, "", "?" + params.toString()); // Push the new URL without reloading

          const backUrl =
            pageFindSearch?.dataset?.backurl ?? window.location.pathname;
          sessionStorage.setItem("backUrl", `${backUrl}?${params.toString()}`);

          return term;
        },
      });

      // If search param exists (eg: search?q=astro), trigger search
      const query = params.get(SEARCH_QUERY_PARAM);
      if (query) {
        search.triggerSearch(query);
      }

      // Reset search param if search input is cleared
      const searchInput = document.querySelector(".pagefind-ui__search-input");
      const clearButton = document.querySelector(".pagefind-ui__search-clear");
      searchInput?.addEventListener("input", resetSearchParam);
      clearButton?.addEventListener("click", resetSearchParam);

      function resetSearchParam(e: Event) {
        if ((e.target as HTMLInputElement)?.value.trim() === "") {
          history.replaceState(history.state, "", window.location.pathname);
        }
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    // if pagefind search form already exists, don't initialize search component
    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });
  initSearch();
</script>

<style is:global>
  #pagefind-search {
    /* ★ 这一页的界面是 PagefindUI 自己渲染的，改不了 DOM，只能从它的
       CSS 变量这一侧对齐站内的设计令牌。**四个值要和别处一致**，
       对不上的表现是同一个站里两种搜索框（这一页一种、集合列表页一种）：
         背景 → --surface（和卡片同一层面，不是页底）
         圆角 → 0.75rem，即 theme.css 的 --radius-app
       改 --radius-app 时这里要跟着改 —— 它不能写成 var(--radius-app)，
       那个变量注册在 Tailwind 的 @theme inline 里，不保证出现在 :root 上。 */
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--muted);
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--foreground);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--border);
      background-color: var(--surface);
    }

    input:focus-visible {
      outline: 1px solid var(--accent);
      border-color: var(--border-strong);
    }

    /* 细实线下划线，和正文里的链接同一套（见 typography.css 里那段：
       虚线压在汉字底下会和笔画撞在一起）。 */
    .pagefind-ui__result-title a {
      color: var(--accent);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
      text-decoration-color: color-mix(in oklab, currentColor 35%, transparent);
    }

    .pagefind-ui__result-title a:hover {
      text-decoration-color: currentColor;
    }

    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    /* ★【2026-09-18 实测踩到】命中高亮**必须在这里再写一遍**。
     *
     * global.css 里已经有一条 `mark { … }` 把浏览器默认的黄底换成了灰底，
     * 集合列表页上的检索结果确实是灰的 —— 但这一页里高亮仍然是**荧光黄**。
     * 原因不是选择器权重，是**层叠层**：那条规则写在 `@layer base` 里，而
     * `@pagefind/default-ui/css/ui.css` 是普通（无层）样式，
     * **无层样式整体压过任何 @layer**，权重再低也赢。
     *
     * 这个 <style is:global> 块同样无层，所以放在这里才盖得住。
     * ⚠ 别把它挪回 global.css 去"统一管理"——挪过去就静默失效，
     *   而且只有构建后打开这一页才看得见（dev 里 PagefindUI 根本不初始化）。 */
    mark {
      background-color: var(--muted);
      color: var(--foreground);
      border-radius: 2px;
      padding: 0 2px;
      font-weight: 600;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }
  }
</style>
